{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C/C++: 빌드하고 실행 (확인)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/cpp-run.ps1",
        "-Source",
        "${file}",
        "-Mode",
        "${input:cppRunMode}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true,
        "focus": true
      }
    },
    {
      "label": "C/C++: 빌드만 (확인)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/cpp-run.ps1",
        "-Source",
        "${file}",
        "-Mode",
        "${input:cppBuildMode}"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    },
    {
      "label": "자동 동기화 시작 (auto-sync)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/auto-sync.ps1",
        "-VaultPath",
        "${workspaceFolder}"
      ],
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated",
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "지금 바로 커밋 & 푸시",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/auto-sync.ps1",
        "-VaultPath",
        "${workspaceFolder}",
        "-Once"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "problemMatcher": []
    },
    {
      "label": "C++: Build active file",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-g",
        "-Wall",
        "-Wextra",
        "-std=c++20",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "C: Build active file",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/gcc.exe",
      "args": [
        "-g",
        "-Wall",
        "-Wextra",
        "-std=c17",
        "${file}",
        "-o",
        "${fileDirname}/${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": "$gcc",
      "group": "build"
    },
    {
      "label": "C++: Build all files in current folder",
      "type": "shell",
      "command": "C:/msys64/ucrt64/bin/g++.exe",
      "args": [
        "-g",
        "-Wall",
        "-Wextra",
        "-std=c++20",
        "${fileDirname}/*.cpp",
        "-o",
        "${fileDirname}/program.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": "$gcc",
      "group": "build"
    }
  ],
  "inputs": [
    {
      "id": "cppRunMode",
      "type": "pickString",
      "description": "MSYS2 g++/gcc 로 빌드할까요?",
      "options": [
        {
          "label": "빌드하고 실행",
          "value": "build-run"
        },
        {
          "label": "빌드만 하기",
          "value": "build-only"
        },
        {
          "label": "빌드 없이 기존 exe 실행",
          "value": "run-only"
        },
        {
          "label": "취소",
          "value": "cancel"
        }
      ],
      "default": "build-run"
    },
    {
      "id": "cppBuildMode",
      "type": "pickString",
      "description": "디버그 전에 빌드할까요?",
      "options": [
        {
          "label": "빌드하기",
          "value": "build-only"
        },
        {
          "label": "빌드 건너뛰기",
          "value": "run-only"
        },
        {
          "label": "취소",
          "value": "cancel"
        }
      ],
      "default": "build-only"
    }
  ]
}
