{
    "tasks": [
        {
            "type": "shell",
            "label": "C/C++: g++.exe 분할 컴파일 빌드 (Lab1)",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-std=c++17",
                "-g",
                "course.cpp",
                "app.cpp",
                "-o",
                "app.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "course.cpp + app.cpp 를 함께 컴파일/링크합니다."
        }
    ],
    "version": "2.0.0"
}
